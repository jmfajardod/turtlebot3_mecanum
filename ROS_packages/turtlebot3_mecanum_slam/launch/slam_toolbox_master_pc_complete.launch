<?xml version="1.0"?>
<launch>

    <!-- ************************************************************************ -->
    <!-- Init SLAM Tool -->

    <!-- Launch SLAM -->
    <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
        <rosparam command="load" file="$(find turtlebot3_mecanum_slam)/config/mapper_params_online_async.yaml" />
    </node>

    <!-- ************************************************************************************************ -->
    <!-- ************************************************************************************************ -->
    <!-- RViz -->
    <node 
        pkg="rviz" 
        type="rviz" 
        name="rviz" 
        args="-d $(find turtlebot3_mecanum_slam)/rviz/slam.rviz"
    />

</launch>